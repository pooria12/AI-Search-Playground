# AI Search Playground - example environment variables
# Copy to .env for local development. Never commit real secrets.

# Cloudflare (set by wrangler / deployment, do not hardcode)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Search execution bounds (Cloudflare Workers Free-plan friendly)
SEARCH_MAX_EXPANDED_NODES=20000
SEARCH_MAX_GENERATED_NODES=50000
SEARCH_MAX_EVENTS=20000
SEARCH_MAX_GRID_COLS=60
SEARCH_MAX_GRID_ROWS=40
SEARCH_TIMEOUT_MS=8000

# Default grid (20 columns x 15 rows)
DEFAULT_GRID_COLS=20
DEFAULT_GRID_ROWS=15
